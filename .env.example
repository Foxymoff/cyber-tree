# Шаблон переменных окружения. Скопировать в .env.local и заполнить:
#   cp .env.example .env.local
#
# .env.local в репозиторий не попадает — он закрыт в .gitignore.
# На проде значения задаются в настройках проекта Vercel.

# Строка подключения к Neon (Postgres).
# Можно оставить пустой: тогда проект поднимается на моках из lib/db/mock.ts.
# Это рабочий режим, по нему отлаживают форму, админку и дерево без базы.
DATABASE_URL=

# Общий пароль для входа в панель модератора /admin.
# Полноценной авторизации по ТЗ не требуется: один пароль на всех,
# после ввода кладётся в httpOnly-cookie.
ADMIN_PASSWORD=
